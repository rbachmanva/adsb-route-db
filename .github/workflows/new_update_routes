name: Update ADS-B Routes DB

on:
  schedule:
    # Runs twice a day at 05:00 and 17:00 UTC (~01:00 and 13:00 Eastern)
    - cron: '0 5,17 * * *'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build-routes:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - run: pip install FlightRadarAPI

      - run: python scripts/update_routes_free.py

      - name: Commit and Push
        run: |
          git config --local user.name "github-actions[bot]"
          git config --local user.email "github-actions[bot]@users.noreply.github.com"
          git add routes_master.json routes.bin
          if git diff --staged --quiet; then
            echo "No changes."
          else
            git commit -m "Auto-update hybrid routes.bin [$(date -u +'%Y-%m-%d %H:%M UTC')]"
            git pull --rebase -X ours origin main
            git push origin HEAD:main
          fi
